{
  "manifest_version": 3,
  "name": "Tax Practice Platform — Portal Autofill",
  "version": "0.1.0",
  "description": "Fills your stored username/password into a government/business portal login page, then stops for you to complete CAPTCHA/OTP/MFA yourself. Never touches those fields.",
  "key": "",
  "icons": {
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["tabs", "scripting", "storage", "webNavigation"],
  "host_permissions": [
    "http://localhost/*",
    "https://services.gst.gov.in/*",
    "https://www.gst.gov.in/*",
    "https://eportal.incometax.gov.in/*",
    "https://*.tdscpc.gov.in/*",
    "https://www.mca.gov.in/*",
    "https://*.epfindia.gov.in/*",
    "https://www.esic.gov.in/*",
    "https://www.dgft.gov.in/*"
  ],
  "externally_connectable": {
    "matches": ["http://localhost:3101/*", "http://localhost:3000/*"]
  }
}
