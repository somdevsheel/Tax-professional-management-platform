# Copy to .env and fill in real values for local development.
# NEVER commit a real .env file. See docs/security-design.md for secret-handling rules.

# --- API ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# --- Database ---
# Host port 5544, not the default 5432 — see infrastructure/docker-compose.yml.
DATABASE_URL=postgresql://tax_platform:tax_platform@localhost:5544/tax_platform?schema=public

# --- Redis ---
REDIS_URL=redis://localhost:6390

# --- Object Storage (MinIO locally, S3-compatible in production) ---
OBJECT_STORAGE_ENDPOINT=http://localhost:19010
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=tax-platform-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin

# --- Auth ---
# RS256 keypair for JWT signing. Generate locally, never reuse across environments:
#   openssl genrsa -out jwt-private.pem 2048
#   openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt-public.pem
JWT_ACCESS_TOKEN_TTL=15m
JWT_ISSUER=tax-platform
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_PEPPER=change-me-in-real-environments-never-commit-real-value

# --- Credential Vault Key Management ---
# "local" provider is for development only — it derives a KEK from KEK_LOCAL_DEV_SECRET.
# Production must use "kms" or "vault" (see docs/security-design.md §5).
KMS_PROVIDER=local
KEK_LOCAL_DEV_SECRET=change-me-in-real-environments-never-commit-real-value

# --- Rate limiting ---
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
# Set to "true" only when the API genuinely sits behind exactly one trusted reverse proxy/load
# balancer (docs/deployment.md's topology) — it makes Express trust the client IP reported by
# that one hop's X-Forwarded-For, which is what per-client rate limiting needs to work at all
# behind a proxy. Never enable this with no proxy in front, or with an untrusted one: it turns
# IP-based rate limiting into something any client can spoof via its own X-Forwarded-For header.
TRUST_PROXY=false
